{
  "AllowedHosts": "*",
  "Logging": {
    "FilePath": "logs/network-tools-.json",
    "RollingInterval": "Day",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "MikroTik": {
    "Host": "",
    "Port": 443,
    "Protocol": "https",
    "User": "",
    "Password": ""
  },
  "RemoteRouters": {
    "User": "",
    "Password": "",
    "Port": 443,
    "Protocol": "https"
  }
}
